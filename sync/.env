# Arquivo .env para sincronizador IMAP
# Substitua os valores abaixo pelos reais antes de executar o script.

# Origem (servidor 1)
HOST_ORIGEM=
PORTA_ORIGEM=993
SSL_ORIGEM=true

# Destino (servidor 2)
HOST_DESTINO=
PORTA_DESTINO=993
SSL_DESTINO=true

# Arquivo CSV com as contas (relativo ao diretório onde o script roda)
CSV_FILE=sync.csv

# Timeout em segundos para conexões de socket
TIMEOUT=10

# Se true, pergunta ao usuário se deve continuar ao ocorrer erro em uma conta
PROMPT_ON_ERROR=false
